   ELSE
   PAX=STARTX+((COLUMNS-COL-1)*SPACINGX)
  ENDIF
 ENDIF
ELSE
NO L TO R FOR EVEN ROWS (STARTING WITH ROW 0)
NO IF LAYOUT IS MATRIX:
 IF LAYOUT=1
  PAX=(COL*SPACINGX)+STARTX
 ELSE
NO LAYOUT IS STAGGERED:
  IF @FRAC[ROW/2]=.5
   PAX=((COL+0.5)*SPACINGX)+STARTX
  ELSE
   PAX=(COL*SPACINGX)+STARTX
  ENDIF
 ENDIF
ENDIF
