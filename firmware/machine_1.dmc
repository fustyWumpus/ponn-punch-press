   ENDIF
  ELSE
  NO EVEN ROW:
   NO L TO R FOR EVEN ROWS (STARTING WITH ROW 0)
   IF LAYOUT=1
    PAX=STARTX
   ELSE
    NO LAYOUT IS STAGGERED:
    IF @FRAC[ROW/2]=0.5
     PAX=STARTX+(SPACINGX*0.5)
    ELSE
     PAX=STARTX
    ENDIF
   ENDIF
  ENDIF
