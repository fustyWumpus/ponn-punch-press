VACCNT=VACCNT+1
IF VACCNT<VACOFF
NO TURN VACUUM OFF (OR LEAVE OFF)
CB2
ENDIF
IF VACCNT>=(VACON+VACOFF)
NO TURN VACUUM OFF:
CB2
