JP#NEWROW,COL>=COLUMNS
ENDIF
NO NEXT POSITION IN THIS ROW:
NO R TO L FOR ODD ROWS
IF @FRAC[ROW/2]=.5
NO IF LAYOUT IS MATRIX:
IF LAYOUT=1
PAX=STARTX+((COLUMNS-COL-1)*SPACINGX)
ELSE
NO LAYOUT IS STAGGERED:
IF @FRAC[ROW/2]=.5
PAX=STARTX+((COLUMNS-COL-0.5)*SPACINGX)
ELSE
PAX=STARTX+((COLUMNS-COL-1)*SPACINGX)
ENDIF
ENDIF
ELSE
NO L TO R FOR EVEN ROWS (STARTING WITH ROW 0)
NO IF LAYOUT IS MATRIX:
IF LAYOUT=1
PAX=(COL*SPACINGX)+STARTX
ELSE
NO LAYOUT IS STAGGERED:
IF @FRAC[ROW/2]=.5
PAX=((COL+0.5)*SPACINGX)+STARTX
ELSE
PAX=(COL*SPACINGX)+STARTX
ENDIF
ENDIF
ENDIF
BGX
COL=COL+1
COUNT=COUNT+1
CYCCOUNT=CYCCOUNT+1
NO
